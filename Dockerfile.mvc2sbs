# ── mvc2sbs image ────────────────────────────────────────────────────────────
#
# Multi-architecture: everything here is built from source or packaged for every
# architecture, so this image works on amd64 and on arm64 (Apple Silicon, a
# Raspberry Pi 4/5). tsMuxeR is built rather than downloaded for exactly that
# reason — upstream publishes one Linux binary and it is x86_64, but its CLI
# needs no Qt and compiles anywhere.
#
# Still a separate image from the pipeliner server: a conversion is hours of CPU
# or GPU work, and hardware encoding needs device passthrough (/dev/dri, or the
# NVIDIA container runtime). That belongs in a container started for the job,
# not in the long-lived scheduler.
#
# The toolchain is small because the decoder is used directly: edge264 reads an
# MVC stream and writes the eyes side by side as Y4M, so there is no
# frameserver, no VapourSynth, no Python and no source plugin — which is most of
# what mvc2sbs has to build. Everything here either comes from apt or is one
# small C program.

# ── Go build ──────────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS gobuild
ARG TARGETARCH
ARG TARGETVARIANT
ARG VERSION=dev
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN GOARM="${TARGETVARIANT#v}" CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
    go build -ldflags="-s -w -X main.version=${VERSION}" -o mvc2sbs ./cmd/mvc2sbs

# ── edge264 ───────────────────────────────────────────────────────────────────
FROM alpine:latest AS decoder
# The only open-source software MVC decoder; libavcodec drops the dependent view.
# Pinned to a release tag so an image rebuild is reproducible.
ARG EDGE264_TAG=v2026.09.22
RUN apk --no-cache add build-base git ca-certificates
# Two build settings matter here. STATIC=yes links the decoder into the one
# binary that gets copied out, so the runtime stage needs no library. And the
# Makefile defaults to -march=native, which would bake this builder's CPU into
# the image, so an architecture baseline is forced instead: x86-64-v2 (SSE4.1,
# ~2009 onwards) or armv8-a+simd, which is every 64-bit Arm. The decoder's SIMD
# paths are enabled by -march, so dropping it entirely would cost real speed.
ARG TARGETARCH
RUN git clone -q https://github.com/jens-duttke/edge264-mvc.git /src/edge264 \
    && cd /src/edge264 && git checkout -q ${EDGE264_TAG} \
    && case "$TARGETARCH" in \
         amd64) BASE="-march=x86-64-v2" ;; \
         arm64) BASE="-march=armv8-a+simd" ;; \
         *)     BASE="" ;; \
       esac \
    && make STATIC=yes BUILDTEST=yes \
         CFLAGS="-O3 -std=gnu11 $BASE -mtune=generic -flax-vector-conversions -Wno-override-init -pthread" \
         -j"$(nproc)" \
    && install -m755 edge264_test /out-edge264

# ── tsMuxeR ───────────────────────────────────────────────────────────────────
FROM alpine:latest AS demuxer
# Built rather than downloaded: upstream's release binaries demux MVC but the
# Linux one is x86_64 only, and this image runs on arm64 too. The CLI needs no
# Qt — that is only the GUI — so it is cmake plus zlib and freetype, about a
# minute. The policy flag is for Alpine's cmake 4, which refuses the old minimum
# tsMuxeR's CMakeLists declares.
ARG TSMUXER_REF=master
RUN apk --no-cache add build-base cmake samurai git ca-certificates \
      zlib-dev freetype-dev linux-headers
RUN git clone -q https://github.com/justdan96/tsMuxer.git /src/tsmuxer \
    && cd /src/tsmuxer && git checkout -q ${TSMUXER_REF} \
    && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    && ninja -C build tsmuxer \
    && install -m755 build/tsMuxer/tsmuxer /out-tsmuxer

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata ffmpeg x264 mkvtoolnix

COPY --from=decoder /out-edge264 /usr/local/bin/edge264
COPY --from=demuxer /out-tsmuxer /usr/local/bin/tsMuxeR
COPY --from=gobuild /build/mvc2sbs /usr/local/bin/mvc2sbs

# Where a caller mounts the source and the destination library.
VOLUME ["/media"]

ENTRYPOINT ["/usr/local/bin/mvc2sbs"]
CMD ["--check"]
